{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:feature": "node scripts/validate-feature-policy.mjs",
    "validate:scenarios": "node --experimental-strip-types scripts/validate-scenarios.ts",
    "verify:cloudflare-config": "node scripts/verify-cloudflare-config.mjs",
    "verify:cloudflare-output": "node scripts/verify-cloudflare-output.mjs",
    "check": "npm run validate:feature && npm run lint && npm run type-check && npm test && npm run audit:prod",
    "build:worker": "node scripts/verify-cloudflare-output.mjs --build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "npm run verify:cloudflare-config && npm run build:worker && opennextjs-cloudflare deploy",
    "predeploy:test:direct": "npm run validate:feature",
    "deploy:test:direct": "node scripts/deploy-direct-test.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.7",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.563.0",
    "next": "16.2.11",
    "postcss": "^8.5.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "typescript-eslint": "8.65.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    }
  }
}
