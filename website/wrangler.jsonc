{
  "$schema": "https://developers.cloudflare.com/workers/configuration/schema.json",
  "name": "magireader",
  "pages_build_output_dir": ".open-next/assets",
  "compatibility_date": "2026-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_CACHE_BUCKET",
      "bucket_name": "magi-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "e6546f3eebf94393b6ca3e85b5536d7b"
    }
  ]
}